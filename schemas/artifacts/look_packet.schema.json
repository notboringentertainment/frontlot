{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/look_packet",
  "title": "Look Packet",
  "description": "Output of the look_lock stage (authored-film 1.2): one ratified look per proposal cast entity (D18: an in_progress checkpoint may carry a partial packet, complete=false). Each entry carries the validated look_spec, its look_hash (sha256 of the canonical payload), the receipt_id of the active look_lock approval receipt, and its source: a wayfinder ticket reference ({id} for new tickets, {path, content_sha256} for legacy ones) or a WriterOS promotion (source_ref), exactly one. (entity_kind, entity_id) is unique (enforced by validate_artifact).",
  "type": "object",
  "required": ["version", "looks"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "looks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_kind", "entity_id", "look_spec", "look_hash", "receipt_id"],
        "oneOf": [{ "required": ["source_ticket_ref"] }, { "required": ["source_ref"] }],
        "properties": {
          "entity_kind": { "type": "string", "enum": ["character", "location"] },
          "entity_id": { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 1 },
          "look_spec": { "type": "object" },
          "look_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "receipt_id": { "type": "string", "minLength": 1 },
          "source_ticket_ref": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id"],
                "properties": { "id": { "type": "string", "pattern": "^wf-[0-9a-f]{8}$" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["path", "content_sha256"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "additionalProperties": false
              }
            ]
          },
          "source_ref": {
            "description": "A WriterOS promotion (look sessions, 2026-09-30): the memory record the look was promoted as, the revision of the export it was read from, and the writer's reference-image mode.",
            "type": "object",
            "required": ["system", "record_id", "memory_revision", "reference"],
            "properties": {
              "system": { "const": "writeros" },
              "record_id": { "type": "string", "pattern": "^mem_[0-9a-f]{32}$" },
              "memory_revision": { "type": "integer", "minimum": 0 },
              "reference": { "type": "string", "enum": ["none", "generated-elsewhere", "casting-inspiration"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "complete": {
      "type": "boolean",
      "description": "D18: true when every proposal_packet.cast entity has an entry; a partial packet (false) may be checkpointed in_progress but never completed."
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
